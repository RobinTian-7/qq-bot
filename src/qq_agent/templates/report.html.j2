<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>班级群日报 · {{ day }}</title>
<style>
:root{
  --bg:#f6f7f9; --card:#ffffff; --fg:#16181d; --muted:#6b7280; --line:#e5e7eb;
  --accent:#2563eb; --hi:#dc2626; --mid:#d97706; --lo:#9ca3af;
  --hi-bg:#fef2f2; --mid-bg:#fffbeb; --lo-bg:#f9fafb; --chip:#eef2ff; --chip-fg:#3730a3;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0f1115; --card:#171a21; --fg:#e6e8ec; --muted:#9aa1ac; --line:#262a33;
    --accent:#60a5fa; --hi:#f87171; --mid:#fbbf24; --lo:#6b7280;
    --hi-bg:#241618; --mid-bg:#241f14; --lo-bg:#1b1e25; --chip:#1e2438; --chip-fg:#a5b4fc;
  }
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--fg);
  font:16px/1.75 -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:820px; margin:0 auto; padding:32px 20px 64px}
header{margin-bottom:28px}
h1{font-size:26px; margin:0 0 6px; letter-spacing:-.01em}
.headline{font-size:18px; color:var(--fg); margin:14px 0 0; padding:14px 16px;
  background:var(--card); border-left:3px solid var(--accent); border-radius:0 8px 8px 0}
.date{color:var(--muted); font-size:14px}

.urgent{margin:22px 0 0; padding:16px 18px; background:var(--hi-bg);
  border:1px solid color-mix(in srgb, var(--hi) 30%, transparent); border-radius:10px}
.urgent h2{margin:0 0 8px; font-size:15px; color:var(--hi); letter-spacing:.02em}
.urgent ul{margin:0; padding-left:20px}
.urgent li{margin:4px 0}

h2.sec{font-size:14px; color:var(--muted); font-weight:600; letter-spacing:.06em;
  margin:34px 0 14px; text-transform:none}

.item{background:var(--card); border:1px solid var(--line); border-radius:12px;
  padding:18px 20px; margin-bottom:14px; border-left:4px solid var(--lo)}
.item.hi{border-left-color:var(--hi)}
.item.mid{border-left-color:var(--mid)}
.item h3{margin:0 0 10px; font-size:18px; line-height:1.4; display:flex; gap:8px; align-items:baseline}
.num{color:var(--muted); font-variant-numeric:tabular-nums; font-weight:500; font-size:15px}
.meta{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px}
.chip{font-size:12.5px; padding:2px 9px; border-radius:999px; background:var(--chip); color:var(--chip-fg)}
.chip.due{background:var(--hi-bg); color:var(--hi); font-weight:600}
.chip.grp{background:var(--accent); color:var(--card); font-weight:600}
.chip.imp-高{background:var(--hi-bg); color:var(--hi)}
.chip.imp-中{background:var(--mid-bg); color:var(--mid)}
.chip.imp-低{background:var(--lo-bg); color:var(--muted)}
.summary{margin:0 0 12px}
.points{margin:0 0 12px; padding-left:20px; color:var(--fg)}
.points li{margin:3px 0}
.actions{margin:12px 0 0; padding:12px 14px; background:var(--lo-bg);
  border:1px dashed var(--line); border-radius:8px}
.actions .lbl{font-size:12.5px; color:var(--muted); letter-spacing:.04em; margin-bottom:6px}
.actions label{display:flex; gap:9px; align-items:flex-start; margin:5px 0; cursor:pointer}
.actions input{margin-top:6px; flex:0 0 auto; accent-color:var(--accent)}
.actions input:checked + span{text-decoration:line-through; color:var(--muted)}
.links{margin:12px 0 0; display:flex; flex-direction:column; gap:5px}
.links a{color:var(--accent); font-size:14px; word-break:break-all; text-decoration:none}
.links a:hover{text-decoration:underline}
.src{margin-top:10px; font-size:12px; color:var(--muted)}

.notes{margin-top:28px; padding:16px 18px; background:var(--card);
  border:1px solid var(--line); border-radius:10px; color:var(--muted); font-size:14.5px}
.notes h2{margin:0 0 8px; font-size:14px; color:var(--fg)}
footer{margin-top:34px; padding-top:16px; border-top:1px solid var(--line);
  color:var(--muted); font-size:13px}
.empty{background:var(--card); border:1px solid var(--line); border-radius:12px;
  padding:40px 20px; text-align:center; color:var(--muted)}
@media print{
  body{background:#fff}
  .item{break-inside:avoid; box-shadow:none}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>班级群日报</h1>
    <div class="date">{{ day_label }}</div>
    <p class="headline">{{ digest.headline }}</p>
  </header>

  {% if digest.urgent %}
  <section class="urgent">
    <h2>⏰ 马上要做</h2>
    <ul>
      {% for u in digest.urgent %}<li>{{ u }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if items %}
  <h2 class="sec">全部事项 · {{ items|length }} 条</h2>
  {% for it in items %}
  <article class="item {{ 'hi' if it.importance == '高' else ('mid' if it.importance == '中' else '') }}">
    <h3><span class="num">{{ loop.index }}.</span><span>{{ badge.get(it.importance, '') }} {{ it.title }}</span></h3>
    <div class="meta">
      {% if show_group and it.group %}<span class="chip grp">{{ it.group }}</span>{% endif %}
      <span class="chip">{{ it.category }}</span>
      <span class="chip imp-{{ it.importance }}">重要度 {{ it.importance }}</span>
      {% if it.deadline %}<span class="chip due">截止 {{ it.deadline }}</span>{% endif %}
    </div>
    <p class="summary">{{ it.summary }}</p>
    {% if it.key_points %}
    <ul class="points">
      {% for p in it.key_points %}<li>{{ p }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if it.actions %}
    <div class="actions">
      <div class="lbl">要做的事</div>
      {% for a in it.actions %}
      <label><input type="checkbox"><span>{{ a }}</span></label>
      {% endfor %}
    </div>
    {% endif %}
    {% if it.source_urls %}
    <div class="links">
      {% for u in it.source_urls %}<a href="{{ u }}" target="_blank" rel="noopener">🔗 {{ u }}</a>{% endfor %}
    </div>
    {% endif %}
    {% if it.source_message_ids %}
    <div class="src">来源消息：{% for m in it.source_message_ids %}#{{ m }}{{ ", " if not loop.last }}{% endfor %}</div>
    {% endif %}
  </article>
  {% endfor %}
  {% else %}
  <div class="empty">今天群里没有需要处理的信息 🎉</div>
  {% endif %}

  {% if digest.notes %}
  <section class="notes">
    <h2>备注</h2>
    <div>{{ digest.notes }}</div>
  </section>
  {% endif %}

  <footer>
    统计自 {{ meta.n_messages }} 条群消息 · 读取网页 {{ meta.n_pages_ok }} 个{% if meta.n_pages_failed %} · 抓取失败 {{ meta.n_pages_failed }} 个{% endif %}{% if meta.n_pages_dropped %} · 因过长未纳入 {{ meta.n_pages_dropped }} 个{% endif %} · 生成于 {{ generated_at }}
  </footer>
</div>
</body>
</html>
